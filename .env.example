# PostgreSQL
POSTGRES_USER=renfe
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=renfe
# Público (producción): dominio que sirve Caddy
DOMAIN=localhost
# Rate limit (listas CIDR separadas por comas; valores por defecto en código)
# TRUSTED_PROXIES=127.0.0.1/32,::1/128   # proxies cuyo X-Forwarded-For se respeta
# INTERNAL_NETWORKS=127.0.0.1/32,::1/128 # redes sin límite cuando no hay XFF (SSR)
# Intervalos de sondeo (segundos)
POLL_TRIP_UPDATES=25
POLL_VEHICLE_POSITIONS=30
POLL_ALERTS=60
POLL_STATIC=3600
# Web Push (v0.3) — generar con cryptography P-256
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://example.com/fuentes

# Avisos oficiales (v0.3.9, experimental). Ver docs/whatsapp-waha.md
# Token para POST /api/v1/admin/avisos (alta manual, scripts/aviso.sh). Generar uno largo y aleatorio.
# ADMIN_TOKEN=change_me_long_random
# WAHA (WhatsApp no oficial). Solo si se levanta el perfil: --profile waha
# WAHA_URL vacío = ingesta WAHA desactivada. Dentro de la red compose:
# WAHA_URL=http://waha:3000
# WAHA_API_KEY=change_me_waha_key   # el mismo valor que usa el servicio waha
# WAHA_SESSION=default
# Canales "invite:channel_slug:nucleo_code" separados por comas (invite = código tras whatsapp.com/channel/)
# WAHA_CHANNELS=XXXXXXXXXXXXXXXXXXXXXX:cercanias-madrid:madrid
# Segundos entre sondeos de canales WAHA
# POLL_WAHA=120

# RadarDeTrenes: adaptador opcional de enriquecimiento LD (vía, material,
# ETA próxima parada). OFF si RADAR_ENABLED != "1". Reversible por
# completo: la API funciona igual sin él y etiqueta la fuente.
RADAR_ENABLED=
POLL_RADAR=60
