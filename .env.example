# PostgreSQL
POSTGRES_USER=renfe
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=renfe
# Público (producción): dominio que sirve Caddy
DOMAIN=localhost
# Rate limit (listas CIDR separadas por comas; valores por defecto en código)
# TRUSTED_PROXIES=127.0.0.1/32,::1/128   # proxies cuyo X-Forwarded-For se respeta
# INTERNAL_NETWORKS=127.0.0.1/32,::1/128 # redes sin límite cuando no hay XFF (SSR)
# Intervalos de sondeo (segundos)
POLL_TRIP_UPDATES=25
POLL_VEHICLE_POSITIONS=30
POLL_ALERTS=60
POLL_STATIC=3600
# Web Push (v0.3) — generar con cryptography P-256
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://example.com/fuentes
