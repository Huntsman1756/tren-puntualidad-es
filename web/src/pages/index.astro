---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.svelte';
import JourneySearch from '../components/JourneySearch.svelte';
import { api } from '../lib/api';
import { fmtDelay } from '../lib/format';

let ranking: any[] = [];
let status: any = null;
try {
  [ranking, status] = await Promise.all([api.ranking(8), api.status()]);
} catch {}
const maxAge = status?.feeds ? Math.max(
  status.feeds.rt_trip_updates_cer?.age_sec ?? 9999,
  status.feeds.rt_trip_updates_ld?.age_sec ?? 9999) : null;
---
<Base>
  <h1>Tu tren, sin complicaciones</h1>
  <p class="muted">Salidas, llegadas y retrasos de cualquier estación Renfe —
    Cercanías, Rodalies, AVE, Larga y Media Distancia.</p>

  <div class="card">
    <SearchBox client:load autoFocus={true} />
    <p class="muted hint">Prueba con «Atocha», «Sants», «Alcala» o un nº de tren como «06180».</p>
  </div>

  <div class="card">
    <h2>Trayecto origen → destino</h2>
    <JourneySearch client:load />
  </div>

  {maxAge !== null && maxAge > 180 && (
    <div class="card alert" role="alert">
      Los datos en tiempo real llevan {Math.round(maxAge / 60)} min sin actualizarse.
      Los horarios mostrados pueden ser solo los programados.
    </div>
  )}

  {ranking.length > 0 && (
    <div class="card">
      <h2>Mayores retrasos ahora · <a href="/retrasos">ver todos</a></h2>
      <table class="board">
        <tbody>
          {ranking.map((r: any) => {
            const d = fmtDelay(r.delay);
            return (
              <tr>
                <td><span class="line-tag">{r.line || '—'}</span></td>
                <td><a href={`/tren/${r.feed}/${encodeURIComponent(r.trip_id)}`}>{r.train_number || r.trip_id}</a></td>
                <td class="hide-sm">{r.destination || '—'}</td>
                <td><span class={`badge ${d.cls}`}>{d.text}{r.delay_source === 'observed' ? ' · obs.' : ''}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</Base>
<style>
  h1 { margin-bottom: .2rem; }
  h2 { margin: 0 0 .6rem; font-size: 1rem; }
  h2 a { font-size: .8rem; font-weight: 400; }
  .hint { font-size: .8rem; margin: .6rem 0 0; }
</style>
