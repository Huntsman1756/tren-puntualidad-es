---
import Base from '../../../layouts/Base.astro';
import Board from '../../../components/Board.svelte';
import { api } from '../../../lib/api';
import { FEED_NAME } from '../../../lib/format';

const { feed, id } = Astro.params;

let station, board, alerts = [];
try {
  [station, board, alerts] = await Promise.all([
    api.station(feed, id),
    api.board(feed, id, 'departures', 180),
    api.alerts(feed === 'ld' ? 'cer' : feed, id).catch(() => []),
  ]);
} catch (e) {
  return Astro.redirect('/');
}
---
<Base title={`${station.name} — Puntualidad Renfe`}>
  <p><a href="/">← Buscador</a></p>
  <h1>{station.name}</h1>
  <p class="muted">{FEED_NAME[station.feed] || station.network}</p>

  {alerts.length > 0 && alerts.map((a) => (
    <div class="card alert">
      <strong>Aviso:</strong> {a.text || a.effect || 'Incidencia en la estación'}
    </div>
  ))}

  <div class="card">
    <Board client:load feed={feed} stopId={id}
           initialItems={board.items} initialKind="departures" />
  </div>
</Base>
