---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.svelte';
import FavStar from '../../components/FavStar.svelte';
import AlertButton from '../../components/AlertButton.svelte';
import LineBadge from '../../components/LineBadge.svelte';
import IncidentCard from '../../components/IncidentCard.svelte';
import SourceStatus from '../../components/SourceStatus.svelte';
import DateBar from '../../components/DateBar.astro';
import { api, coverageMax, feedsOf } from '../../lib/api';
import { FEED_NAME } from '../../lib/format';
import { madridToday } from '../../lib/dates';

const key = Astro.params.key || '';
const pairs = key.split(',').map((p) => p.trim().split(':')).filter((p) => p.length === 2);
if (!pairs.length) return Astro.redirect('/');

const today = madridToday();
const date = Astro.url.searchParams.get('date') || '';
const time = Astro.url.searchParams.get('time') || '';

const infos = (await Promise.all(
  pairs.map(([f, s]) => api.station(f, s).catch(() => null)),
)).filter(Boolean) as any[];
if (!infos.length) return new Response(null, { status: 404, statusText: 'Not found' });

let board: any = { items: [] };
let boardError = false;
const [b, coverage, inc, punct] = await Promise.all([
  api.board(key, 'departures', 180, date || undefined, time || undefined)
    .catch(() => { boardError = true; return null; }),
  api.coverage().catch(() => null),
  api.incidencias({ estacion: key }).catch(() => null),
  api.punctuality(infos[0].feed, infos[0].stop_id, 7).catch(() => null),
]);
if (b) board = b;
const name = infos[0].name;
const networks = [...new Set(infos.map((i) => FEED_NAME[i.feed] || i.network))];
const lines = infos.flatMap((i) => i.lines || []);
const canonical = `/estacion/${key}`;
const maxDate = coverageMax(coverage, feedsOf(key));
const here = (inc?.items || []).filter((a: any) =>
  ['station', 'line', 'line_mentions_station'].includes(a.relevance));
const elsewhere = (inc?.items || []).filter((a: any) => a.relevance === 'line_other_station');
---
<Base title={`${name} — horarios, líneas y avisos | Trenes a tiempo`}
    description={`Próximas salidas y llegadas en ${name}: horarios programados, estimaciones en tiempo real, retrasos, líneas y avisos oficiales de Renfe.`}
    canonical={canonical}>
  <nav class="breadcrumb" aria-label="Migas"><a href="/">Inicio</a> › <a href="/estaciones">Estaciones</a> › {name}</nav>
  <div class="title-row">
    <h1>{name}</h1>
    <FavStar client:load k={key} name={name} />
  </div>
  <p class="muted">{networks.join(' + ')}
    {infos[0].geo && (
      <> · {infos[0].geo.poblacion && <>{infos[0].geo.poblacion} · </>}
        <a href={`/provincias/${infos[0].geo.provincia_slug}`}>{infos[0].geo.provincia}</a> ·{' '}
        <a href={`/comunidades/${infos[0].geo.ccaa_slug}`}>{infos[0].geo.ccaa}</a></>
    )}
  </p>
  {lines.length > 0 && (
    <p class="lines" aria-label="Líneas que paran aquí">
      {lines.map((l: any) => <LineBadge line={l} showNucleo={false} />)}
      {lines[0]?.nucleo && <span class="muted small">{lines[0].nucleo.brand} {lines[0].nucleo.name}</span>}
    </p>
  )}
  <AlertButton client:load cfg={{ type: 'station', station_key: key }} label={name} />

  {here.map((a: any) => <IncidentCard a={a} context="station" />)}
  {elsewhere.length > 0 && (
    <details class="others"><summary>{elsewhere.length} aviso{elsewhere.length === 1 ? '' : 's'} de estas líneas en otras estaciones</summary>
      {elsewhere.map((a: any) => <IncidentCard a={a} context="station" compact />)}
    </details>
  )}
  {inc && infos.some((i) => i.feed === 'cer') && here.length === 0 &&
    <SourceStatus source={inc.source} count={0} />}

  <DateBar action={`/estacion/${key}`} date={date || today} time={time} max={maxDate} />

  <div class="card">
    {boardError && <p class="errnote" role="alert">Error de consulta: no se ha podido cargar el
      panel. Se reintentará automáticamente.</p>}
    <Board client:load stops={key} initialItems={board.items}
      initialMeta={board} initialKind="departures" date={date} time={time} />
  </div>

  {punct && (punct.circulations_with_rt || punct.observations) > 0 && (
    <div class="card">
      <h2 style="margin-top:0;font-size:1rem">Retrasos informados — últimos {punct.days} días</h2>
      <p>
        Con dato en tiempo real: <strong>{punct.circulations_with_rt ?? punct.trips_observed}</strong> circulaciones
        {(punct.coverage_pct ?? punct.coverage_observed_pct) != null &&
          <> ({punct.coverage_pct ?? punct.coverage_observed_pct}% de las programadas)</>}.
      </p>
      <table class="board"><tbody>
        <tr><td>Informados puntuales (≤2 min)</td><td><strong>{punct.on_time_2min_pct}%</strong></td></tr>
        <tr><td>Retraso mediano informado</td><td>{Math.round(punct.delay_median_sec / 60)} min</td></tr>
        <tr><td>P90</td><td>{Math.round(punct.delay_p90_sec / 60)} min</td></tr>
        <tr><td>&gt;5 min de retraso</td><td>{punct.delayed_over_5min_pct}%</td></tr>
      </tbody></table>
      <p class="muted" style="font-size:.75rem">{punct.note}</p>
    </div>
  )}
</Base>
<style>
  .title-row { display: flex; align-items: baseline; gap: .5rem; }
  .title-row h1 { margin-bottom: .2rem; }
  .lines { display: flex; gap: .4rem; flex-wrap: wrap; align-items: center; margin: .2rem 0 .5rem; }
  .small { font-size: .78rem; }
  .others summary { cursor: pointer; font-size: .82rem; color: var(--muted); margin: .3rem 0; }
  .errnote { color: var(--warn); font-size: .82rem; margin: .2rem 0; }
</style>
