---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.svelte';
import FavStar from '../../components/FavStar.svelte';
import AlertButton from '../../components/AlertButton.svelte';
import { api } from '../../lib/api';
import { FEED_NAME } from '../../lib/format';

const key = Astro.params.key || '';
const pairs = key.split(',').map((p) => p.trim().split(':')).filter((p) => p.length === 2);
if (!pairs.length) return Astro.redirect('/');

const date = Astro.url.searchParams.get('date') || '';
const time = Astro.url.searchParams.get('time') || '';

let infos: any[] = [];
let board: any = { items: [] };
let alerts: any[] = [];
let punct: any = null;
let coverage: any = null;
try {
  infos = (await Promise.all(
    pairs.map(([f, s]) => api.station(f, s).catch(() => null)),
  )).filter(Boolean);
  if (!infos.length) return Astro.redirect('/');
  [board, coverage] = await Promise.all([
    api.board(key, 'departures', 180, date || undefined, time || undefined),
    api.coverage().catch(() => null),
  ]);
  const alertLists = await Promise.all(
    infos.map((i) => api.alerts(i.feed, i.stop_id).catch(() => [])),
  );
  const seen = new Set();
  alerts = alertLists.flat().filter((a) => (seen.has(a.id) ? false : seen.add(a.id)));
  punct = await api.punctuality(infos[0].feed, infos[0].stop_id, 7).catch(() => null);
} catch (e) {
  return Astro.redirect('/');
}
const name = infos[0].name;
const networks = [...new Set(infos.map((i) => FEED_NAME[i.feed] || i.network))];
const canonical = `/estacion/${key}`;
const maxDate = coverage
  ? Object.values(coverage.feeds || {}).map((f: any) => f.last_day).sort().reverse()[0]
  : undefined;
---
<Base title={`${name} — horarios y retrasos | Trenes a tiempo`}
    description={`Próximas salidas y llegadas en ${name}: horarios programados, estimaciones en tiempo real, retrasos y avisos de Renfe.`}
    canonical={canonical}>
  <nav class="breadcrumb"><a href="/">← Buscador</a></nav>
  <div class="title-row">
    <h1>{name}</h1>
    <FavStar client:load k={key} name={name} />
  </div>
  <p class="muted">{networks.join(' + ')}</p>
  {infos[0].geo && (
    <p class="muted geo-line">
      {infos[0].geo.poblacion && <>{infos[0].geo.poblacion} · </>}
      <a href={`/provincias/${infos[0].geo.provincia_slug}`}>{infos[0].geo.provincia}</a> ·{' '}
      <a href={`/comunidades/${infos[0].geo.ccaa_slug}`}>{infos[0].geo.ccaa}</a>
    </p>
  )}
  <AlertButton client:load cfg={{ type: 'station', station_key: key }} label={name} />

  {alerts.map((a) => (
    <div class="card alert" role="alert">
      <strong>Aviso:</strong> {a.text || 'Incidencia notificada por Renfe'}
    </div>
  ))}

  <form class="dtbar card tight" method="get" action={`/estacion/${key}`}>
    <label>Fecha <input type="date" name="date" value={date} min={coverage?.today}
      max={maxDate} /></label>
    <label>Hora <input type="time" name="time" value={time} /></label>
    <button type="submit">Consultar</button>
    {(date || time) && <a class="today" href={`/estacion/${key}`}>Ahora</a>}
  </form>

  <div class="card">
    <Board client:load stops={key} initialItems={board.items}
      initialMeta={board} initialKind="departures" date={date} time={time} />
  </div>

  {punct && punct.observations > 0 && (
    <div class="card">
      <h2 style="margin-top:0;font-size:1rem">Puntualidad últimos {punct.days} días</h2>
      <p>
        Con observación: <strong>{punct.trips_observed}</strong> trenes
        {punct.coverage_observed_pct != null && <> ({punct.coverage_observed_pct}% de los programados)</>}.
      </p>
      <table class="board"><tbody>
        <tr><td>Puntuales (≤2 min)</td><td><strong>{punct.on_time_2min_pct}%</strong></td></tr>
        <tr><td>Retraso mediano</td><td>{Math.round(punct.delay_median_sec / 60)} min</td></tr>
        <tr><td>P90</td><td>{Math.round(punct.delay_p90_sec / 60)} min</td></tr>
        <tr><td>&gt;5 min de retraso</td><td>{punct.delayed_over_5min_pct}%</td></tr>
      </tbody></table>
      <p class="muted" style="font-size:.75rem">{punct.note}</p>
    </div>
  )}
</Base>
<style>
  .title-row { display: flex; align-items: baseline; gap: .5rem; }
  .title-row h1 { margin-bottom: .2rem; }
  .dtbar { display: flex; gap: .7rem; align-items: end; flex-wrap: wrap; font-size: .85rem; }
  .dtbar label { display: flex; flex-direction: column; gap: .2rem; color: var(--muted); }
  .dtbar input { font-size: .9rem; padding: .4rem .5rem; }
  .dtbar button { padding: .45rem .9rem; border-radius: 8px; border: 1px solid var(--border);
                  background: var(--accent); color: var(--accent-fg); font-weight: 600;
                  cursor: pointer; }
  .dtbar .today { align-self: center; font-size: .85rem; }
</style>
