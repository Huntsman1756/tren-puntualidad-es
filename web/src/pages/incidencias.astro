---
import Base from '../layouts/Base.astro';
import IncidentCard from '../components/IncidentCard.svelte';
import SourceStatus from '../components/SourceStatus.svelte';
import IncidentSignals from '../components/IncidentSignals.svelte';
import OfficialNotices from '../components/OfficialNotices.svelte';
import { api } from '../lib/api';
import { isOpen } from '../lib/signals';
import { fmtStamp } from '../lib/format';

const sp = Astro.url.searchParams;
const f = {
  nucleo: sp.get('nucleo') || '',
  linea: sp.get('linea') || '',
  estacion: sp.get('estacion') || '',
  categoria: sp.get('categoria') || '',
  estado: sp.get('estado') || '',
  fuente: sp.get('fuente') || '',
  periodo: sp.get('periodo') || 'actuales',
};
// Con filtro de estado se piden todos los hilos (7 días) y se filtra aquí;
// sin él, solo los abiertos con novedad en 24 h.
const avisoOpts = f.estado
  ? { aviso_estado: 'todos', aviso_horas: '168' } : {};
let data: any = null;
let nucleos: any[] = [];
let anom: any = null;
let error: string | null = null;
let stationName = '';
const lineaFiltro = f.nucleo && f.linea ? f.linea : undefined;
try {
  [data, nucleos, anom] = await Promise.all([
    api.incidencias({
      nucleo: f.nucleo || undefined,
      linea: lineaFiltro,
      estacion: f.estacion || undefined,
      categoria: f.categoria || undefined,
      periodo: f.periodo,
      ...avisoOpts,
    }),
    api.nucleos().catch(() => []),
    // Señales inferidas: si fallan, la sección muestra su estado vacío.
    // Incluye resueltos; se filtran abajo a los de las últimas 6 h.
    api.anomalias({ nucleo: f.nucleo || undefined, linea: lineaFiltro, incluir_resueltas: '1' })
      .catch(() => null),
  ]);
  if (f.estacion) {
    const [fe, st] = f.estacion.split(',')[0].split(':');
    stationName = await api.station(fe, st).then((s: any) => s.name).catch(() => st);
  }
} catch (e: any) {
  error = e?.status === 404 ? 'Núcleo o línea desconocidos.' : 'No se han podido cargar las incidencias.';
}
const nuc = nucleos.find((n: any) => n.slug === f.nucleo);
const nowS = Math.floor(Date.now() / 1000);
const SIX_H = 6 * 3600;
// Abiertos + resueltos de las últimas 6 h.
const sigItems: any[] = (anom?.items || []).filter((it: any) =>
  isOpen(it) || (it.resolved_at != null && nowS - it.resolved_at <= SIX_H));
// Avisos de canales oficiales: filtro de estado y de fuente (whatsapp|manual).
let notices: any[] = data?.official_notices || [];
if (f.estado) notices = notices.filter((t: any) => t.status === f.estado);
if (f.fuente === 'whatsapp' || f.fuente === 'manual')
  notices = notices.filter((t: any) => t.source === f.fuente || t.messages?.some((m: any) => m.source === f.fuente));
const waHealth = data?.sources?.whatsapp || null;
// Filtro de estado sobre avisos GTFS-RT (status distintos: active/upcoming/…)
const ESTADO_GTFS: Record<string, string[]> = {
  activa: ['active'], en_recuperacion: ['active'],
  normalizada: ['withdrawn', 'expired'],
};
let gtfsItems: any[] = data?.items || [];
if (f.estado && ESTADO_GTFS[f.estado]) {
  gtfsItems = gtfsItems.filter((a: any) => ESTADO_GTFS[f.estado].includes(a.status));
} else if (f.estado === 'sin_actualizar') {
  gtfsItems = [];   // no existe equivalente en el feed oficial
}
const gtfsStale = !!data?.source?.content_stale
  || ['down', 'stale', 'unknown'].includes(data?.source?.status);
const showA = !f.fuente || ['whatsapp', 'manual'].includes(f.fuente);
const showB = !f.fuente || f.fuente === 'inferidas';
const showC = !f.fuente || f.fuente === 'gtfs';
const CATS: Record<string, string> = data?.categories || {
  accesibilidad: 'Accesibilidad', obras: 'Obras programadas',
  interrumpido: 'Servicio interrumpido', alternativo: 'Servicio alternativo',
  otras: 'Otras afectaciones',
};
const PERIODS: Record<string, string> = {
  actuales: 'Publicadas ahora', vigentes: 'Vigentes ahora', proximas: 'Próximas',
  recientes: 'Retiradas (7 días)', todas: 'Todas (7 días)',
};
const ESTADOS: Record<string, string> = {
  activa: 'Activa', en_recuperacion: 'En recuperación',
  normalizada: 'Normalizada', sin_actualizar: 'Sin actualizar',
};
const FUENTES: Record<string, string> = {
  whatsapp: 'Canal WhatsApp (auto)', manual: 'Entrada manual',
  gtfs: 'Feed GTFS-RT', inferidas: 'Inferidas por retrasos',
};
const scopeTitle = f.estacion ? `en ${stationName}`
  : nuc ? (f.linea ? `línea ${nuc.lines.find((l: any) => l.slug === f.linea)?.code
           ?? nuc.lines.flatMap((l: any) => l.variants).find((v: any) => v.slug === f.linea)?.code
           ?? f.linea} · ${nuc.name}` : `núcleo ${nuc.name}`)
  : 'en Cercanías y Rodalies';
const hasFilters = f.nucleo || f.categoria || f.estacion || f.estado || f.fuente
  || f.periodo !== 'actuales';
---
<Base title={`Incidencias ${scopeTitle} — Trenes a tiempo`}
      description="Incidencias y avisos oficiales de Renfe por núcleo, línea y estación: qué pasa ahora, qué ha comunicado Renfe y qué se infiere de los retrasos.">
  <nav class="breadcrumb" aria-label="Migas"><a href="/">Inicio</a> › Incidencias</nav>
  <h1>Incidencias {scopeTitle}</h1>
  <p class="muted">Qué está pasando ahora: avisos de los canales oficiales de Renfe,
    problemas inferidos de los retrasos en tiempo real y el feed oficial GTFS-RT.
    Cada fuente va etiquetada; no inventamos severidades.</p>

  <form class="filters card tight" method="get" action="/incidencias">
    <label>Núcleo
      <select name="nucleo">
        <option value="">Todos</option>
        {nucleos.map((n: any) => <option value={n.slug} selected={n.slug === f.nucleo}>{n.name}</option>)}
      </select>
    </label>
    {nuc && (
      <label>Línea
        <select name="linea">
          <option value="">Todas</option>
          {nuc.lines.map((l: any) => (
            <>
              <option value={l.slug} selected={l.slug === f.linea}>{l.code}</option>
              {l.variants.filter((v: any) => v.slug !== l.slug).map((v: any) =>
                <option value={v.slug} selected={v.slug === f.linea}>&nbsp;&nbsp;{v.code}</option>)}
            </>
          ))}
        </select>
      </label>
    )}
    <label>Estado
      <select name="estado">
        <option value="">Cualquiera</option>
        {Object.entries(ESTADOS).map(([k, v]) => <option value={k} selected={k === f.estado}>{v}</option>)}
      </select>
    </label>
    <label>Tipo
      <select name="categoria">
        <option value="">Todos</option>
        {Object.entries(CATS).map(([k, v]) => <option value={k} selected={k === f.categoria}>{v}</option>)}
      </select>
    </label>
    <label>Fuente
      <select name="fuente">
        <option value="">Todas</option>
        {Object.entries(FUENTES).map(([k, v]) => <option value={k} selected={k === f.fuente}>{v}</option>)}
      </select>
    </label>
    <label>Periodo GTFS
      <select name="periodo">
        {Object.entries(PERIODS).map(([k, v]) => <option value={k} selected={k === f.periodo}>{v}</option>)}
      </select>
    </label>
    {f.estacion && <input type="hidden" name="estacion" value={f.estacion} />}
    <button type="submit">Filtrar</button>
    {hasFilters && <a href="/incidencias" class="reset">Quitar filtros</a>}
  </form>

  {showA && (
    <section class="card" aria-labelledby="of-h" id="avisos-oficiales">
      <h2 id="of-h">Avisos oficiales (canales de Renfe)</h2>
      {waHealth && waHealth.status !== 'disabled' && (
        <p class={`wa ${waHealth.status}`} role="status">
          Captura WhatsApp:
          {waHealth.status === 'ok' && <> operativa</>}
          {waHealth.status === 'stale' && <> sin descargas recientes</>}
          {waHealth.status === 'down' && <> con errores</>}
          {waHealth.status === 'degraded' && <> degradada</>}
          {waHealth.session && <> · sesión {waHealth.session}</>}
        </p>
      )}
      <p class="muted note">Mensajes publicados por Renfe en sus canales, con el texto original.
        No se editan ni se resumen.</p>
      <OfficialNotices items={notices} empty="Sin avisos oficiales con estos filtros" />
    </section>
  )}

  {showB && !f.estacion && (
    <section class="card" aria-labelledby="inf-h">
      <h2 id="inf-h">Posibles incidencias inferidas</h2>
      <p class="muted note">Calculadas a partir de los retrasos informados en tiempo real.
        No son avisos oficiales de Renfe. Se muestran los abiertos y los resueltos de las últimas 6 h.</p>
      <IncidentSignals items={sigItems} empty="Sin retrasos generalizados detectados ahora." />
    </section>
  )}

  {showC && (
    <section class="card" aria-labelledby="gtfs-h">
      <h2 id="gtfs-h">Avisos del feed oficial GTFS-RT</h2>
      {error && <div class="alert" role="alert">{error}</div>}
      {data && (
      <>
        <SourceStatus source={data.source} count={data.total} />
        {gtfsStale && gtfsItems.length > 0 && (
          <details class="frozen">
            <summary>
              {gtfsItems.length} aviso{gtfsItems.length === 1 ? '' : 's'} en el feed,
              contenido sin cambios desde {fmtStamp(data.source.content_changed_at)}
              {' '}— <strong>no son novedades de hoy</strong>
            </summary>
            <p class="muted note">El feed sigue publicándolos (conservan su activePeriod),
              pero el contenido no cambió desde entonces; pueden estar vigentes o ya
              retirados sin que Renfe lo haya actualizado.</p>
            {gtfsItems.map((a: any) => <IncidentCard a={a} />)}
          </details>
        )}
        {!gtfsStale && (
          <>
            {gtfsItems.length > 0 && (
              <p class="counts muted">
                {gtfsItems.length} aviso{gtfsItems.length === 1 ? '' : 's'} ·{' '}
                {Object.entries(data.counts.by_category).map(([k, n]) => (
                  <a href={`/incidencias?${new URLSearchParams({ ...Object.fromEntries(Object.entries(f).filter(([, v]) => v)), categoria: k })}`}
                     class="cnt">{CATS[k] || k}: {n as number}</a>
                ))}
              </p>
            )}
            {gtfsItems.length === 0 && data.source?.status === 'ok' && (
              <div class="card muted">No hay avisos oficiales {PERIODS[f.periodo].toLowerCase()} con estos
                filtros. La fuente está operativa: la ausencia de avisos no garantiza que no haya
                retrasos, consulta el <a href="/retrasos">ranking en vivo</a>.</div>
            )}
            {gtfsItems.map((a: any) => <IncidentCard a={a} />)}
          </>
        )}
        {gtfsStale && gtfsItems.length === 0 && (
          <p class="muted">Sin avisos en el feed (contenido sin cambios).</p>
        )}
      </>
      )}
    </section>
  )}
  <p class="muted small">Fuente: Renfe Operadora, GTFS-RT Service Alerts
    (<a href="https://data.renfe.com">data.renfe.com</a>, CC-BY 4.0). Auditoría técnica:
    <a href="/api/v1/incidencias/audit">/api/v1/incidencias/audit</a>.
    Renfe no publica avisos GTFS-RT para AV/Larga Distancia.</p>
</Base>
<style>
  .filters { display: flex; gap: .6rem; flex-wrap: wrap; align-items: end; font-size: .85rem; }
  .filters label { display: flex; flex-direction: column; gap: .2rem; color: var(--muted); }
  .filters select { width: auto; font-size: .9rem; padding: .4rem .5rem; }
  .filters button { padding: .5rem .9rem; border-radius: 8px; border: 0; background: var(--accent);
                    color: var(--accent-fg); font-weight: 600; cursor: pointer; min-height: 40px; }
  .reset { align-self: center; font-size: .85rem; }
  .counts { font-size: .82rem; display: flex; gap: .5rem; flex-wrap: wrap; }
  .small { font-size: .78rem; margin-top: 1.5rem; }
  h2 { font-size: 1rem; margin: 0 0 .3rem; }
  .note { font-size: .82rem; margin: 0 0 .5rem; }
  .wa { font-size: .8rem; margin: .1rem 0 .4rem; }
  .wa.ok { color: var(--ok); }
  .wa.stale, .wa.degraded { color: var(--warn); }
  .wa.down { color: var(--bad); }
  .frozen { border: 1px solid var(--border); border-radius: 10px; padding: .5rem .8rem; }
  .frozen > summary { cursor: pointer; font-size: .88rem; color: var(--muted); min-height: 36px; }
</style>
