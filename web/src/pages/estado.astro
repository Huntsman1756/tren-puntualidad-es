---
import Base from '../layouts/Base.astro';
import { api } from '../lib/api';

let st: any = null;
let err = false;
try { st = await api.dataStatus(); } catch { err = true; }

const NAMES: Record<string, string> = {
  rt_trip_updates_cer: 'Horarios RT Cercanías/Rodalies',
  rt_trip_updates_ld: 'Horarios RT AV/LD/MD',
  rt_vehicles_cer: 'Posiciones Cercanías',
  rt_vehicles_ld: 'Posiciones AV/LD/MD',
  rt_fleet_cer: 'Flota visor Renfe (observado)',
  rt_alerts_cer: 'Avisos e incidencias',
  static_loaded_cer: 'GTFS estático Cercanías',
  static_loaded_ld: 'GTFS estático AV/LD/MD',
};
function ago(sec?: number) {
  if (sec == null) return 'sin datos';
  if (sec < 90) return `${sec} s`;
  if (sec < 5400) return `${Math.round(sec / 60)} min`;
  return `${(sec / 3600).toFixed(1)} h`;
}
function cls(sec?: number, warn = 120, bad = 900) {
  if (sec == null) return 'nodata';
  return sec <= warn ? 'ok' : sec <= bad ? 'warn' : 'bad';
}
---
<Base title="Estado de los datos — Trenes a tiempo"
    description="Frescura y cobertura en tiempo real de las fuentes oficiales de Renfe utilizadas por esta web.">
  <h1>Estado de los datos</h1>
  <p class="muted">Frescura real de cada fuente. Si un feed lleva minutos sin
    actualizarse, la web lo muestra en lugar de ocultarlo.</p>

  {err && <div class="card alert">No se puede contactar con la API.</div>}
  {st && (
    <>
      <div class="card">
        <h2 style="margin-top:0;font-size:1rem">Frescura por fuente</h2>
        <table class="board">
          <thead><tr><th>Fuente</th><th>Última actualización</th><th>Estado</th></tr></thead>
          <tbody>
            {Object.entries(NAMES).map(([k, label]) => {
              const isStatic = k.startsWith('static');
              const isAlerts = k === 'rt_alerts_cer';
              // avisos: frescura = nuestra última descarga OK (no la fecha del contenido de Renfe)
              const f = isAlerts ? st.feeds.alerts_fetch_ok_cer : st.feeds[k];
              const e = isAlerts ? st.feeds.alerts_fetch_err_cer : null;
              const failed = !!e && (!f || e.ts > f.ts);
              const warn = isStatic ? 172800 : 300;
              const bad = isStatic ? 604800 : 900;
              const state = failed ? 'caída'
                : f ? (f.age_sec <= warn ? 'fresco' : f.age_sec <= bad ? 'atrasado' : 'obsoleto')
                : 'sin datos';
              const stateCls = failed ? 'bad' : cls(f?.age_sec, warn, bad);
              return (
                <tr>
                  <td>{label}</td>
                  <td>{f ? 'hace ' + ago(f.age_sec) : 'sin datos'}
                    {isAlerts && st.feeds.rt_alerts_cer && (
                      <div class="muted" style="font-size:.85em">
                        contenido publicado por Renfe hace {ago(st.feeds.rt_alerts_cer.age_sec)}</div>
                    )}</td>
                  <td><span class={`badge ${stateCls}`}>{state}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="muted" style="font-size:.85em">Avisos e incidencias: el estado mide
          cuándo consultamos con éxito la fuente de Renfe. La fecha de su contenido
          solo cambia cuando Renfe publica o modifica avisos, así que puede ser
          antigua aunque el dato esté al día.</p>
      </div>
      <div class="card">
        <h2 style="margin-top:0;font-size:1rem">Cobertura</h2>
        <table class="board">
          <tbody>
            <tr><td>Estaciones Cercanías/Rodalies</td><td>{st.stations_by_feed?.cer ?? '—'}</td></tr>
            <tr><td>Estaciones AV/LD/MD</td><td>{st.stations_by_feed?.ld ?? '—'}</td></tr>
            <tr><td>Trenes con dato RT ahora (CER)</td><td>{st.active_rt_trips?.cer ?? '—'}</td></tr>
            <tr><td>Trenes con dato RT ahora (LD)</td><td>{st.active_rt_trips?.ld ?? '—'}</td></tr>
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
