---
const key = Astro.params.key || '';
const pairs = key.split(',').map((p) => p.trim().split(':')).filter((p) => p.length === 2);
let err = '';
let detail = '';
try {
  const { api } = await import('../../lib/api');
  const infos = await Promise.all(pairs.map(([f, s]) => api.station(f, s).catch((e) => (err += `station ${f}:${s} -> ${e.message}; `, null))));
  detail += `infos=${infos.filter(Boolean).length}; `;
  const b = await api.board(key, 'departures', 180);
  detail += `board=${b.items.length}`;
} catch (e: any) {
  err += e.message;
}
---
<html><body>
<p>key=[{key}] pairs={JSON.stringify(pairs)}</p>
<p>detail={detail}</p>
<p>err={err}</p>
</body></html>
