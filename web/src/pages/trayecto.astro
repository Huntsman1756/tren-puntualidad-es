---
import Base from '../layouts/Base.astro';
import SaveJourney from '../components/SaveJourney.svelte';
import AlertButton from '../components/AlertButton.svelte';
import LineBadge from '../components/LineBadge.svelte';
import IncidentCard from '../components/IncidentCard.svelte';
import DateBar from '../components/DateBar.astro';
import { api, coverageMax, feedsOf } from '../lib/api';
import { fmtDelay, fmtTime, fmtDuration } from '../lib/format';
import { madridToday, relDay } from '../lib/dates';

const sp = Astro.url.searchParams;
const from = sp.get('from') || '';
const to = sp.get('to') || '';
const today = madridToday();
const date = sp.get('date') || '';
const time = sp.get('time') || '';
const semidirect = sp.get('semidirect') === '1';
const day = date || today;

let plan: any = null;
let error: string | null = null;
let fromName = 'Origen', toName = 'Destino';
let coverage: any = null;
let inc: any = null;
if (from && to) {
  const fp = from.split(',')[0].split(':');
  const tp = to.split(',')[0].split(':');
  const [p, fn, tn, cov, al] = await Promise.allSettled([
    api.plan(from, to, { date: date || undefined, time: time || undefined,
                         semidirect: semidirect || undefined }),
    api.station(fp[0], fp[1]).then((s: any) => s.name),
    api.station(tp[0], tp[1]).then((s: any) => s.name),
    api.coverage(),
    api.incidencias({ origen: from, destino: to }),
  ]);
  if (p.status === 'fulfilled') plan = p.value;
  else error = 'Error de consulta: no se ha podido calcular el trayecto. Inténtalo de nuevo.';
  if (fn.status === 'fulfilled') fromName = fn.value;
  if (tn.status === 'fulfilled') toName = tn.value;
  if (cov.status === 'fulfilled') coverage = cov.value;
  if (al.status === 'fulfilled') inc = al.value;
}
const items: any[] = plan?.items || [];
const keep = (o: Record<string, string>) => {
  const p = new URLSearchParams({ from, to });
  if (date) p.set('date', date);
  if (time) p.set('time', time);
  if (semidirect) p.set('semidirect', '1');
  for (const [k, v] of Object.entries(o)) v ? p.set(k, v) : p.delete(k);
  return p.toString();
};
const swapHref = `/trayecto?${keep({ from: to, to: from })}`;
const canonical = `/trayecto?${keep({})}`;
const maxDate = coverageMax(coverage, [...feedsOf(from), ...feedsOf(to)]);
const STATUS_TXT: Record<string, string> = {
  no_direct_window: 'Sin servicios directos en esta franja',
  out_of_coverage: 'Fuera de la cobertura del calendario',
  transfer_only: 'Solo con transbordo',
  needs_transfer: 'Requiere transbordo',
  different_networks: 'Requiere transbordo entre redes',
};
const trainHref = (j: any) => `/tren/${j.feed}/${encodeURIComponent(j.trip_id)}`
  + (j.service_date !== today ? `?date=${j.service_date}` : '');
const relevant = (inc?.items || []).filter((a: any) => a.relevance !== 'line_other_station');
const others = (inc?.items || []).filter((a: any) => a.relevance === 'line_other_station');
---
<Base title={`${fromName} → ${toName} — horarios y retrasos`}
    description={`Trenes directos de ${fromName} a ${toName}: hora programada, estimada, retrasos en tiempo real, avisos oficiales y servicios semidirectos.`}
    canonical={canonical}>
  <nav class="breadcrumb" aria-label="Migas"><a href="/">Inicio</a> › <a href="/horarios">Horarios</a> › Trayecto</nav>
  <div class="head">
    <h1>{fromName} → {toName}</h1>
    <a class="swaplink" href={swapHref} title="Trayecto inverso">⇅ vuelta</a>
  </div>
  <AlertButton client:load cfg={{ type: 'journey', from_key: from, to_key: to }}
    label={`${fromName} → ${toName}`} />

  <DateBar action="/trayecto" date={day} time={time} max={maxDate}
           hidden={{ from, to, ...(semidirect ? { semidirect: '1' } : {}) }}
           extra="semidirect" semidirect={semidirect} />

  {relevant.length > 0 && (
    <section aria-label="Avisos oficiales del trayecto">
      {relevant.map((a: any) => <IncidentCard a={a} context="journey" compact />)}
    </section>
  )}
  {others.length > 0 && (
    <details class="others"><summary>{others.length} aviso{others.length === 1 ? '' : 's'} de estas líneas en otras estaciones</summary>
      {others.map((a: any) => <IncidentCard a={a} context="journey" compact />)}
    </details>
  )}

  {error && <div class="card alert" role="alert">{error}</div>}

  {plan && plan.status !== 'ok' && (
    <div class="card state" role="status">
      <strong>{STATUS_TXT[plan.status] || plan.status}</strong>
      <p>{plan.message}</p>
      {plan.status === 'out_of_coverage' && plan.coverage_gap?.last_day && (
        <p class="muted">El horario oficial publicado llega hasta el {relDay(plan.coverage_gap.last_day, today)}.</p>)}
      {plan.status === 'no_direct_window' && (
        <p><a href={`/trayecto?${keep({ time: '' })}`}>Ver el día completo</a></p>)}
      {(plan.status === 'needs_transfer' || plan.status === 'different_networks') && (
        <p class="muted">No hay conexión verificable en esta franja. Puedes consultar las
          salidas de <a href={`/estacion/${from}`}>{fromName}</a> para ver a qué estaciones hay
          servicio directo.</p>)}
    </div>
  )}

  {plan?.scheduled_only && plan.status === 'ok' && (
    <p class="card tight muted sched-note">Horario programado del {relDay(day, today)} — sin datos
      en tiempo real para fechas futuras.</p>
  )}

  {items.length > 0 && (
    <div class="card">
      <div class="jhead">
        <SaveJourney client:load fromKey={from} fromName={fromName} toKey={to}
          toName={toName} semidirect={semidirect} />
        <span class="muted count">{items.length} trenes directos · {relDay(day, today)}{time ? ` desde las ${time}` : date ? ', día completo' : ''}</span>
      </div>
      <div class="jlist">
        {items.map((j: any) => {
          const d = fmtDelay(j.delay_sec);
          const late = j.realtime && j.arr_estimated !== j.arr_scheduled;
          return (
            <a class={`jrow ${j.cancelled ? 'cancelled' : ''}`} href={trainHref(j)}>
              <div class="jtimes">
                <span class="t">{fmtTime(j.dep_scheduled)}</span>
                <span class="arrow">→</span>
                <span class="t">{fmtTime(j.arr_scheduled)}</span>
                {late && <span class="est">→ {fmtTime(j.arr_estimated)}</span>}
              </div>
              <div class="jmeta">
                <span class="slot s-line"><LineBadge line={j.line_info} fallback={j.line} link={false} showNucleo={false} /></span>
                <span class="slot s-dur"><span class="muted dur">{fmtDuration(j.dep_scheduled, j.arr_scheduled)}</span></span>
                <span class="slot s-semi">{j.semidirect && <span class="badge semi">omite {j.skipped_stops}</span>}</span>
                <span class="slot s-train"><span class="muted tnum">{j.train_number}</span></span>
                <span class="slot s-status"><span class={`badge ${j.cancelled ? 'cancel' : j.realtime ? d.cls : 'nodata'}`}>
                  {j.cancelled ? 'suprimido' : j.realtime ? d.text : 'prog.'}
                </span></span>
              </div>
            </a>
          );
        })}
      </div>
      <p class="muted legend">Solo trenes directos (sin transbordo). Toca un tren para ver su
        recorrido del {relDay(day, today).toLowerCase()}. prog. = horario programado (sin dato RT).</p>
    </div>
  )}

  {plan?.transfers?.length > 0 && (
    <div class="card">
      <div class="jhead">
        <strong>Con un transbordo</strong>
        <span class="muted count">{plan.transfers.length} opciones · {relDay(day, today)}</span>
      </div>
      <div class="xlist">
        {plan.transfers.map((x: any) => {
          const tr = x.transfer;
          const dep = x.leg1 ? x.leg1.dep_scheduled : tr.dep_suggested;
          const l1late = x.leg1 && x.leg1.realtime && x.leg1.dep_estimated !== x.leg1.dep_scheduled;
          return (
            <div class={`xrow ${x.risk}`}>
              <div class="jtimes">
                <span class="t">{fmtTime(dep)}</span>
                <span class="arrow">→</span>
                <span class="t">{fmtTime(x.arr_epoch)}</span>
              </div>
              <div class="xmeta">
                <span class="xleg">
                  {x.leg1
                    ? <>{x.leg1.line_info?.code || x.leg1.line || x.leg1.train_number}
                        {x.leg1.train_number ? ` · ${x.leg1.train_number}` : ''}
                        {l1late && <span class="est"> (est. {fmtTime(x.leg1.dep_estimated)})</span>}</>
                    : <>A pie desde {tr.at_name || tr.at_stop}</>}
                </span>
                <span class="xchg muted">
                  ⇄ {tr.at_name || tr.at_stop}
                  {tr.to_stop !== tr.at_stop && <> → {tr.to_name || tr.to_stop}</>}
                  {' '}· cambio mín. {Math.round(tr.slack_sec / 60)}′
                  {tr.buffer_sec != null && x.leg1 && <> · espera {Math.round(tr.buffer_sec / 60)}′</>}
                </span>
                <span class="xleg">
                  {x.leg2
                    ? <>{x.leg2.line_info?.code || x.leg2.line || x.leg2.train_number}
                        {x.leg2.train_number ? ` · ${x.leg2.train_number}` : ''}
                        {' '}→ {x.leg2.to_name || x.leg2.to_stop}
                        {x.leg2.realtime && x.leg2.dep_estimated !== x.leg2.dep_scheduled &&
                          <span class="est"> (est. {fmtTime(x.leg2.dep_estimated)})</span>}</>
                    : <>Llegada a pie · {tr.to_name || tr.to_stop}</>}
                </span>
              </div>
              <span class={`badge x-${x.risk}`}>
                {x.risk === 'ok' ? 'holgado' : x.risk === 'tight' ? 'justo' : 'riesgo RT'}
              </span>
            </div>
          );
        })}
      </div>
      <p class="muted legend">Solo enlaces verificados (misma estación, estación contigua del
        catálogo o correspondencia oficial). justo = margen estrecho; riesgo RT = la estimación
        en tiempo real ya no cubre el cambio mínimo — plan alternativo recomendado.</p>
    </div>
  )}
</Base>
<style>
  .head { display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap; }
  .head h1 { margin-bottom: .2rem; font-size: 1.35rem; }
  .swaplink { font-size: .85rem; white-space: nowrap; }
  .state p { margin: .35rem 0 0; }
  .others summary { cursor: pointer; font-size: .82rem; color: var(--muted); margin: .3rem 0; }
  .sched-note { font-size: .82rem; margin-top: .4rem; }
  .jhead { display: flex; justify-content: space-between; align-items: center; gap: .5rem;
           flex-wrap: wrap; margin-bottom: .4rem; }
  .count { font-size: .78rem; }
  .jlist { display: flex; flex-direction: column; }
  /* Escritorio: cada fila es un grid con columnas fijas; la columna de horas no
     depende del contenido de la fila, así que los datos quedan alineados. */
  .jrow { display: grid; grid-template-columns: 14.5rem minmax(0, 1fr); column-gap: .8rem;
          align-items: center; padding: .6rem .3rem; border-top: 1px solid var(--border);
          color: var(--text); border-radius: 6px; min-height: 44px; }
  .jrow:first-child { border-top: 0; }
  .jrow:hover { background: var(--card2); }
  .jtimes { display: flex; align-items: baseline; gap: .35rem; white-space: nowrap;
            min-width: 0; font-variant-numeric: tabular-nums; }
  .jtimes .t { font-size: 1.05rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .jtimes .arrow { color: var(--muted); }
  .jtimes .est { color: var(--warn); font-size: .85rem; }
  .jmeta { display: grid; grid-template-columns: 3.2rem 3.6rem 5.4rem 4.4rem 6.2rem;
           column-gap: .5rem; align-items: center; justify-content: end;
           font-variant-numeric: tabular-nums; min-width: 0; }
  .slot { min-width: 0; display: flex; align-items: center; }
  .s-line, .s-semi, .s-status { justify-content: flex-start; }
  .s-dur, .s-train { justify-content: flex-start; }
  .dur { font-size: .82rem; white-space: nowrap; }
  .tnum { font-size: .78rem; white-space: nowrap; }
  .jmeta .badge { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .cancelled { opacity: .55; }
  .xlist { display: flex; flex-direction: column; }
  .xrow { display: grid; grid-template-columns: 9rem minmax(0,1fr) auto; gap: .6rem;
          align-items: center; padding: .6rem .3rem; border-top: 1px solid var(--border); }
  .xrow:first-child { border-top: 0; }
  .xmeta { display: flex; flex-direction: column; gap: .15rem; min-width: 0;
           font-size: .82rem; }
  .xleg { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .xchg { font-size: .78rem; }
  .badge.x-ok { background: #14532d; color: #bbf7d0; }
  .badge.x-tight { background: #713f12; color: #fde68a; }
  .badge.x-risky { background: #7f1d1d; color: #fecaca; }
  .legend { font-size: .75rem; margin: .6rem 0 0; }
  @media (max-width: 560px) {
    .xrow { grid-template-columns: minmax(0,1fr) auto; }
    .xrow .jtimes { grid-column: 1; }
    .xmeta { grid-column: 1 / -1; }
    .xrow .badge { grid-column: 2; grid-row: 1; align-self: start; }
  }
  /* Tablet: horas arriba, datos alineados debajo (sin columnas que se aprieten). */
  @media (min-width: 561px) and (max-width: 760px) {
    .jrow { grid-template-columns: minmax(0, 1fr); row-gap: .3rem; }
    .jmeta { justify-content: start; }
  }
  @media (max-width: 560px) {
    .jrow { display: flex; flex-direction: column; align-items: stretch; gap: .3rem; }
    .jmeta { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: .5rem; }
    .slot { display: contents; }
  }
</style>
