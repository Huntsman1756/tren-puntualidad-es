---
const {
  title = 'Trenes a tiempo — puntualidad Renfe',
  description = 'Salidas, llegadas y retrasos de trenes Renfe por estación y trayecto, con datos oficiales en tiempo real.',
  canonical,
} = Astro.props;
const fwdHost = Astro.request.headers.get('x-forwarded-host')
  || Astro.request.headers.get('host') || new URL(Astro.url).host;
const fwdProto = Astro.request.headers.get('x-forwarded-proto') || 'https';
const siteOrigin = (typeof process !== 'undefined' && process.env?.PUBLIC_SITE_URL)
  || `${fwdProto}://${fwdHost}`;
const canonicalUrl = canonical ? new URL(canonical, siteOrigin).href
  : `${siteOrigin}${Astro.url.pathname}`;
const path = Astro.url.pathname;
const NAV = [
  ['/horarios', 'Horarios'], ['/estaciones', 'Estaciones'], ['/lineas', 'Líneas'],
  ['/nucleos', 'Núcleos'], ['/incidencias', 'Incidencias'], ['/retrasos', 'Retrasos'],
  ['/estadisticas', 'Estadísticas'], ['/favoritos', 'Favoritos'],
];
const isCur = (href: string) => path === href || path.startsWith(href + '/')
  || (href === '/estaciones' && path.startsWith('/estacion/'))
  || (href === '/nucleos' && path.startsWith('/nucleos/'));
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="es_ES" />
  <meta name="theme-color" content="#0f1419" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚆</text></svg>" />
  <title>{title}</title>
  <script is:inline>
    // tema: localStorage > sistema
    (() => {
      try {
        const t = localStorage.getItem('tt_theme')
          || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = t;
      } catch (e) { document.documentElement.dataset.theme = 'dark'; }
    })();
  </script>
  <style is:global>
    :root {
      --bg: #0f1419; --card: #1a222c; --card2: #141b23; --border: #2a3542;
      --text: #e8eef4; --muted: #9fb0c0; --accent: #4da3ff; --accent-dim: #1a2c40;
      --accent-fg: #06101c;
      --ok: #3ecf8e; --warn: #f5b942; --bad: #ef6351;
      --ok-bg: #12382a; --warn-bg: #403312; --bad-bg: #452020; --nd-bg: #242e39;
      --shadow: 0 8px 24px rgba(0,0,0,.35);
    }
    [data-theme='light'] {
      --bg: #f6f7f9; --card: #ffffff; --card2: #eef1f4; --border: #d8dee5;
      --text: #1b2430; --muted: #4a5b6d; --accent: #0b63ce; --accent-dim: #e3efff;
      --accent-fg: #ffffff;
      --ok: #0e8a5f; --warn: #9a6b00; --bad: #c4382b;
      --ok-bg: #d9f2e7; --warn-bg: #f7ecc9; --bad-bg: #fadcd8; --nd-bg: #e8ecf1;
      --shadow: 0 8px 24px rgba(20,30,45,.10);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
           background: var(--bg); color: var(--text); line-height: 1.45; }
    a { color: var(--accent); text-decoration: none; }
    :focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px; }
    .wrap { max-width: 960px; margin: 0 auto; padding: 1rem; }
    h1 { font-size: 1.5rem; line-height: 1.25; margin: .6rem 0 .3rem; }
    h2 { font-size: 1rem; font-weight: 600; margin: 0 0 .5rem; line-height: 1.3; }
    h3 { font-size: .95rem; font-weight: 600; margin: 0 0 .3rem; line-height: 1.3; }
    .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -.2rem; padding: 0 .2rem; }
    header.site { border-bottom: 1px solid var(--border); padding: .7rem 1rem;
                  position: sticky; top: 0; background: var(--bg); z-index: 20; }
    header.site .wrap { display: flex; gap: 1rem; align-items: center;
                        flex-wrap: wrap; padding: 0 .4rem; }
    header.site a.brand { color: var(--text); font-weight: 700; font-size: 1.05rem;
                          display: flex; align-items: center; gap: .45rem; }
    nav#main-nav { display: flex; gap: .15rem; margin-left: auto; flex-wrap: wrap; }
    .menu-btn { display: none; margin-left: auto; border: 1px solid var(--border);
                background: var(--card); color: var(--text); border-radius: 8px;
                padding: .4rem .7rem; cursor: pointer; font-size: .9rem; min-height: 40px; }
    .skip { position: absolute; left: -999px; top: 0; background: var(--accent);
            color: var(--accent-fg); padding: .5rem .8rem; z-index: 50; }
    .skip:focus { left: .5rem; top: .5rem; }
    @media (max-width: 760px) {
      .menu-btn { display: inline-flex; gap: .3rem; align-items: center; }
      nav#main-nav { display: none; order: 10; width: 100%; flex-direction: column;
                     margin: .4rem 0 .2rem; }
      header.site[data-open] nav#main-nav { display: flex; }
      nav#main-nav a { padding: .65rem .6rem; font-size: 1rem; }
    }
    nav a { color: var(--muted); font-size: .88rem; padding: .35rem .6rem;
            border-radius: 8px; }
    nav a:hover { color: var(--text); background: var(--card2); }
    nav a[aria-current] { color: var(--accent); font-weight: 600; }
    .theme-btn { border: 1px solid var(--border); background: var(--card);
                 border-radius: 8px; padding: .3rem .55rem; cursor: pointer;
                 font-size: .95rem; line-height: 1; }
    .card { background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 1rem; margin: .9rem 0;
            box-shadow: var(--shadow); }
    .card.tight { padding: .7rem .9rem; }
    .badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px;
             font-size: .78rem; font-weight: 600; white-space: nowrap;
             font-variant-numeric: tabular-nums; }
    .badge.ok { background: var(--ok-bg); color: var(--ok); }
    .badge.warn { background: var(--warn-bg); color: var(--warn); }
    .badge.bad { background: var(--bad-bg); color: var(--bad); }
    .badge.nodata { background: var(--nd-bg); color: var(--muted); }
    .badge.cancel { background: var(--bad-bg); color: var(--bad); }
    .badge.semi { background: var(--accent-dim); color: var(--accent); }
    table.board { width: 100%; border-collapse: collapse; font-size: .95rem; }
    table.board th { text-align: left; color: var(--muted); font-weight: 500;
                     font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
                     padding: .4rem .5rem; border-bottom: 1px solid var(--border); }
    table.board td { padding: .55rem .5rem; border-bottom: 1px solid var(--border);
                     font-variant-numeric: tabular-nums; vertical-align: middle; }
    table.board tr.cancelled td { opacity: .55; }
    .muted { color: var(--muted); }
    .small { font-size: .78rem; }
    .breadcrumb { font-size: .9rem; margin-bottom: .3rem; }
    .line-tag { display: inline-block; min-width: 2.2rem; text-align: center;
                border-radius: 6px; padding: .1rem .4rem; font-weight: 700;
                font-size: .85rem; background: var(--card2); }
    input[type=text], input[type=date], input[type=time], select {
      background: var(--card2); color: var(--text);
      border: 1px solid var(--border); border-radius: 8px; padding: .6rem .8rem;
      width: 100%; font-size: 1rem; }
    input[type=date], input[type=time] { width: auto; min-width: 0; }
    button { font-family: inherit; }
    footer.site { margin-top: 3rem; padding: 1.5rem 1rem; border-top: 1px solid var(--border);
                  color: var(--muted); font-size: .8rem; }
    .alert { border-left: 3px solid var(--warn); }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden;
               clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 560px) {
      .hide-sm { display: none; }
      table.board { font-size: .88rem; }
      table.board td { padding: .5rem .3rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">🚆 <span>Trenes a tiempo</span></a>
      <button class="menu-btn" id="menu-toggle" aria-expanded="false"
              aria-controls="main-nav">☰ <span>Menú</span></button>
      <nav aria-label="Principal" id="main-nav">
        {NAV.map(([href, label]) => (
          <a href={href} aria-current={isCur(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <button class="theme-btn" id="theme-toggle" aria-label="Cambiar tema"
              title="Cambiar tema">◐</button>
    </div>
  </header>
  <main class="wrap" id="contenido">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <p>Origen de los datos: Renfe Operadora (portal de datos abiertos data.renfe.com,
        licencia CC-BY 4.0). Proyecto independiente, no oficial, no afiliado ni
        patrocinado por Renfe.</p>
      <p>La ausencia de dato en tiempo real no implica puntualidad.{' '}
        <a href="/fuentes">Metodología y limitaciones</a>{' · '}
        <a href="/estado">Estado de los datos</a>{' · '}
        <a href="/privacidad">Privacidad</a></p>
    </div>
  </footer>
  <script is:inline>
    document.getElementById('menu-toggle')?.addEventListener('click', (e) => {
      const h = document.querySelector('header.site');
      const open = !h.hasAttribute('data-open');
      open ? h.setAttribute('data-open', '') : h.removeAttribute('data-open');
      e.currentTarget.setAttribute('aria-expanded', String(open));
    });
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = cur;
      try { localStorage.setItem('tt_theme', cur); } catch (e) {}
    });
    if ('serviceWorker' in navigator) {
      addEventListener('load', () =>
        navigator.serviceWorker.register('/sw.js').catch(() => {}));
    }
  </script>
</body>
</html>
