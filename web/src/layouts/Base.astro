---
const { title = 'Puntualidad Renfe', description = 'Puntualidad y retrasos de trenes Renfe por estación y trayecto, en tiempo real.' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root {
      --bg: #0f1419; --card: #1a222c; --border: #2a3542;
      --text: #e8eef4; --muted: #8fa0b0; --accent: #4da3ff;
      --ok: #3ecf8e; --warn: #f5b942; --bad: #ef6351;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
           background: var(--bg); color: var(--text); }
    a { color: var(--accent); text-decoration: none; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 1rem; }
    header.site { border-bottom: 1px solid var(--border); padding: .8rem 1rem; }
    header.site .wrap { display: flex; gap: 1.2rem; align-items: baseline; }
    header.site a.brand { color: var(--text); font-weight: 700; font-size: 1.1rem; }
    nav a { color: var(--muted); font-size: .9rem; }
    nav a:hover { color: var(--text); }
    .card { background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 1rem; margin: .8rem 0; }
    .badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px;
             font-size: .8rem; font-weight: 600; }
    .badge.ok { background: #12382a; color: var(--ok); }
    .badge.warn { background: #403312; color: var(--warn); }
    .badge.bad { background: #452020; color: var(--bad); }
    .badge.nodata { background: #242e39; color: var(--muted); }
    .badge.cancel { background: #452020; color: var(--bad); }
    table.board { width: 100%; border-collapse: collapse; font-size: .95rem; }
    table.board th { text-align: left; color: var(--muted); font-weight: 500;
                     font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
                     padding: .4rem .5rem; border-bottom: 1px solid var(--border); }
    table.board td { padding: .55rem .5rem; border-bottom: 1px solid var(--border); }
    table.board tr.cancelled td { opacity: .5; }
    .muted { color: var(--muted); }
    .line-tag { display: inline-block; min-width: 2.2rem; text-align: center;
                border-radius: 6px; padding: .1rem .4rem; font-weight: 700;
                font-size: .85rem; background: #26313d; }
    input[type=text], select { background: #11181f; color: var(--text);
      border: 1px solid var(--border); border-radius: 8px; padding: .6rem .8rem;
      width: 100%; font-size: 1rem; }
    input[type=text]:focus { outline: 2px solid var(--accent); border-color: transparent; }
    footer.site { margin-top: 3rem; padding: 1.5rem 1rem; border-top: 1px solid var(--border);
                  color: var(--muted); font-size: .8rem; }
    .alert { border-left: 3px solid var(--warn); }
    @media (max-width: 560px) {
      .hide-sm { display: none; }
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">🚆 Puntualidad Renfe</a>
      <nav>
        <a href="/retrasos">Retrasos ahora</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      Datos: portal de datos abiertos de Renfe (data.renfe.com), licencia CC-BY 4.0.
      La ausencia de dato en tiempo real no implica puntualidad.
    </div>
  </footer>
</body>
</html>
