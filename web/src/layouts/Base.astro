---
const {
  title = 'Trenes a tiempo — puntualidad Renfe',
  description = 'Salidas, llegadas y retrasos de trenes Renfe por estación y trayecto, con datos oficiales en tiempo real.',
  canonical,
} = Astro.props;
const site = Astro.url.origin;
const canonicalUrl = canonical ? new URL(canonical, site).href : Astro.url.href;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="es_ES" />
  <meta name="theme-color" content="#0f1419" />
  <title>{title}</title>
  <style is:global>
    :root {
      --bg: #0f1419; --card: #1a222c; --border: #2a3542;
      --text: #e8eef4; --muted: #9fb0c0; --accent: #4da3ff;
      --ok: #3ecf8e; --warn: #f5b942; --bad: #ef6351;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
           background: var(--bg); color: var(--text); line-height: 1.45; }
    a { color: var(--accent); text-decoration: none; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px; }
    .wrap { max-width: 780px; margin: 0 auto; padding: 1rem; }
    header.site { border-bottom: 1px solid var(--border); padding: .8rem 1rem; }
    header.site .wrap { display: flex; gap: 1.2rem; align-items: baseline; flex-wrap: wrap; }
    header.site a.brand { color: var(--text); font-weight: 700; font-size: 1.1rem; }
    nav { display: flex; gap: 1rem; }
    nav a { color: var(--muted); font-size: .9rem; }
    nav a:hover { color: var(--text); }
    .card { background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 1rem; margin: .8rem 0; }
    .badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px;
             font-size: .8rem; font-weight: 600; }
    .badge.ok { background: #12382a; color: var(--ok); }
    .badge.warn { background: #403312; color: var(--warn); }
    .badge.bad { background: #452020; color: var(--bad); }
    .badge.nodata { background: #242e39; color: var(--muted); }
    .badge.cancel { background: #452020; color: var(--bad); }
    .badge.obs { background: #0f2d40; color: #6fc3ff; }
    table.board { width: 100%; border-collapse: collapse; font-size: .95rem; }
    table.board th { text-align: left; color: var(--muted); font-weight: 500;
                     font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
                     padding: .4rem .5rem; border-bottom: 1px solid var(--border); }
    table.board td { padding: .55rem .5rem; border-bottom: 1px solid var(--border); }
    table.board tr.cancelled td { opacity: .55; }
    .muted { color: var(--muted); }
    .breadcrumb { font-size: .9rem; margin-bottom: .3rem; }
    .line-tag { display: inline-block; min-width: 2.2rem; text-align: center;
                border-radius: 6px; padding: .1rem .4rem; font-weight: 700;
                font-size: .85rem; background: #26313d; }
    input[type=text], select { background: #11181f; color: var(--text);
      border: 1px solid var(--border); border-radius: 8px; padding: .6rem .8rem;
      width: 100%; font-size: 1rem; }
    button { font-family: inherit; }
    footer.site { margin-top: 3rem; padding: 1.5rem 1rem; border-top: 1px solid var(--border);
                  color: var(--muted); font-size: .8rem; }
    .alert { border-left: 3px solid var(--warn); }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden;
               clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 560px) { .hide-sm { display: none; } }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">Trenes a tiempo</a>
      <nav>
        <a href="/retrasos">Retrasos ahora</a>
        <a href="/estado">Estado de datos</a>
        <a href="/fuentes">Fuentes</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <p>Origen de los datos: Renfe Operadora (portal de datos abiertos data.renfe.com,
        licencia CC-BY 4.0). Proyecto independiente, no oficial, no afiliado ni
        patrocinado por Renfe.</p>
      <p>La ausencia de dato en tiempo real no implica puntualidad.
        <a href="/fuentes">Metodología y limitaciones</a>.</p>
    </div>
  </footer>
</body>
</html>
